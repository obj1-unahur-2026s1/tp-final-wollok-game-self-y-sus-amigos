import scripts.personaje.personaje.*
import scripts.gestionNiveles.niveles.tienda.*
import scripts.gestionNiveles.gestorNivel.*

describe "conjunto de test de personaje" {
    test "el personaje ocupa la posicion donde se encuentra " {
        personaje.position(game.at(8,2))
        assert.that(personaje.ocupaPosicion(game.at(8,2)))
    }
    test "el personaje agrega monedas correctamente" {
        personaje.monedas(50)
        personaje.añadirMoneda(3)
        assert.equals(53, personaje.monedas())
    }
    test "el personaje obtiene la cantidad maxima de intentos" {
        assert.equals(2, personaje.intentosMaximos())
    }


}
describe "Wtest funcionamiento de la tienda" {
    test "antes de nivel 5 no corresponde abrir la tienda" {
        gestorNivel.nivelActual(4)
        assert.notThat(gestorNivel.debeIrATienda())
    }
    test "en el nivel 5 corresponde abrir la tienda" {
        gestorNivel.nivelActual(5)
        assert.that(gestorNivel.debeIrATienda())
    }
    test "en el nivel 6 no corresponde abrir la tienda" {
        gestorNivel.nivelActual(6)
        assert.notThat(gestorNivel.debeIrATienda())
    }
    test "cargar un nivel actualiza el nivel y sale de la tienda" {
        gestorNivel.enTienda(true)
        gestorNivel.cargarNivel(8)

        assert.equals(8, gestorNivel.nivelActual())
        assert.notThat(gestorNivel.enTienda())
    }

    test "el personaje pierde la llave al reiniciar el nivel" {
        personaje.tieneLlave(true)
        gestorNivel.reiniciarNivel()
        assert.notThat(personaje.tieneLlave())
    }
}

